# ── LLM / STT API keys ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
GROQ_API_KEY=gsk_your-key-here
CLAUDE_MODEL=claude-sonnet-4-5

# ── API authentication ───────────────────────────────────────────────────────
# Optional: set a fixed admin API key. If left blank, one is auto-generated
# on first startup and printed to the server log (look for "ADMIN API KEY").
ADMIN_API_KEY=

# ── Frontend ─────────────────────────────────────────────────────────────────
# Copy your API key here so the browser dashboard can authenticate.
# For local development, put this in frontend/.env.local (not committed to git).
VITE_API_KEY=
VITE_API_BASE=http://localhost:8000

# ── Database ─────────────────────────────────────────────────────────────────
# Path to the SQLite file. Defaults to /tmp/onsera_intake.db if not set.
# When running via docker-compose this is set to /data/onsera_intake.db
# (mounted as a named volume for persistence across restarts).
DB_PATH=/tmp/onsera_intake.db
