# Stage 1: build the React app
FROM node:20-alpine AS build

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci --prefer-offline

COPY . .

# Vite reads these at build time — pass via docker build --build-arg or
# docker-compose build args (see deploy/docker-compose.prod.yml)
ARG VITE_API_BASE=""
ARG VITE_API_KEY=""
RUN VITE_API_BASE="$VITE_API_BASE" VITE_API_KEY="$VITE_API_KEY" npm run build

# Stage 2: serve static files with nginx
FROM nginx:1.27-alpine

# Remove default nginx page
RUN rm -rf /usr/share/nginx/html/*

COPY --from=build /app/dist /usr/share/nginx/html

# nginx config is mounted at runtime from deploy/nginx/nginx.conf
# but include a minimal fallback that handles React's client-side routing
RUN printf 'server {\n\
    listen 80;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
    location / { try_files $uri $uri/ /index.html; }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80
