# TEMPLATE — do NOT commit with real values.
# Base64-encode your secrets: echo -n "value" | base64
#
# Apply with:
#   kubectl apply -f deploy/k8s/secret.yaml   (after filling in real values)
#
# For production, prefer a secrets manager (AWS Secrets Manager, Vault, Sealed
# Secrets, or External Secrets Operator) rather than committing this file.

apiVersion: v1
kind: Secret
metadata:
  name: onsera-secrets
  namespace: onsera
type: Opaque
data:
  # echo -n "sk-ant-..." | base64
  ANTHROPIC_API_KEY: <base64-encoded-anthropic-key>
  # echo -n "gsk_..." | base64
  GROQ_API_KEY: <base64-encoded-groq-key>
  # echo -n "ons_..." | base64
  ADMIN_API_KEY: <base64-encoded-admin-api-key>
